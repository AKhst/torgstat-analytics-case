# Базовые настройки PostgreSQL
POSTGRES_DB=torgdb
POSTGRES_USER=torgadmin
POSTGRES_PASSWORD=dummy_admin_password
POSTGRES_PORT=5433
POSTGRES_HOST=localhost
POSTGRES_SCHEMA=raw

# Пользователь для приложения (ETL, dbt)
APP_DB_USER=appuser
APP_DB_PASSWORD=dummy_app_password

# Пользователь только для чтения (Power BI)
READONLY_USER=readonly
READONLY_PASSWORD=dummy_readonly_password

# Пути
PYTHONPATH=src