# PostgreSQL administrator
POSTGRES_DB=torgdb
POSTGRES_USER=torgadmin
POSTGRES_PASSWORD=change_admin_password
POSTGRES_PORT=5433
POSTGRES_HOST=localhost
POSTGRES_SCHEMA=raw

# Data warehouse schemas
RAW_SCHEMA=raw
STAGING_SCHEMA=staging
MARTS_SCHEMA=marts

# Python and dbt role
APP_DB_USER=appuser
APP_DB_PASSWORD=change_app_password

# Read-only BI role
READONLY_USER=readonly
READONLY_PASSWORD=change_readonly_password

# Python environment
PYTHONPATH=src

# Gemini API
GEMINI_API_KEY=replace_with_your_new_gemini_api_key
# Override only when the model is available for your Gemini API project.
GEMINI_MODEL=gemini-3.8-flash
