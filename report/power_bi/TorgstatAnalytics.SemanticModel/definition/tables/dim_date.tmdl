table dim_date
	dataCategory: Time

	column date_day
		dataType: dateTime
		isKey
		summarizeBy: none
		sourceColumn: date_day

	column calendar_year
		dataType: int64
		summarizeBy: none
		sourceColumn: calendar_year

	column calendar_quarter
		dataType: int64
		summarizeBy: none
		sourceColumn: calendar_quarter

	column month_number
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: month_number

	column month_name_short
		dataType: string
		sortByColumn: month_number
		sourceColumn: month_name_short

	column month_name
		dataType: string
		sortByColumn: month_number
		sourceColumn: month_name

	column month_start_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: month_start_date

	column month_end_date
		dataType: dateTime
		summarizeBy: none
		sourceColumn: month_end_date

	column year_month
		dataType: string
		sortByColumn: month_start_date
		sourceColumn: year_month

	column iso_week_number
		dataType: int64
		summarizeBy: none
		sourceColumn: iso_week_number

	column iso_day_of_week
		dataType: int64
		summarizeBy: none
		sourceColumn: iso_day_of_week

	column day_name_short
		dataType: string
		sortByColumn: iso_day_of_week
		sourceColumn: day_name_short

	column day_name
		dataType: string
		sortByColumn: iso_day_of_week
		sourceColumn: day_name

	column is_weekend
		dataType: boolean
		sourceColumn: is_weekend

	partition dim_date = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database(#"Server", #"Database"),
				Navigation = Source{[Schema="marts", Item="dim_date"]}[Data]
			in
				Navigation
