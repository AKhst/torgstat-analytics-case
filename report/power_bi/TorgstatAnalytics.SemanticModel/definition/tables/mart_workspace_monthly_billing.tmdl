table mart_workspace_monthly_billing

	column workspace_month_currency_key
		dataType: string
		isKey
		sourceColumn: workspace_month_currency_key

	column workspace_key
		dataType: string
		isHidden
		sourceColumn: workspace_key

	column workspace_id
		dataType: string
		sourceColumn: workspace_id

	column billing_month
		dataType: dateTime
		summarizeBy: none
		sourceColumn: billing_month

	column source_currency_code
		dataType: string
		sourceColumn: source_currency_code

	column invoice_count
		dataType: int64
		summarizeBy: none
		sourceColumn: invoice_count

	column paid_invoice_count
		dataType: int64
		summarizeBy: none
		sourceColumn: paid_invoice_count

	column eligible_invoice_count
		dataType: int64
		summarizeBy: none
		sourceColumn: eligible_invoice_count

	column eligible_net_amount
		dataType: decimal
		summarizeBy: none
		sourceColumn: eligible_net_amount

	column eligible_tax_amount
		dataType: decimal
		summarizeBy: none
		sourceColumn: eligible_tax_amount

	column eligible_gross_amount
		dataType: decimal
		summarizeBy: none
		sourceColumn: eligible_gross_amount

	partition mart_workspace_monthly_billing = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database(#"Server", #"Database"),
				Navigation = Source{[Schema="marts", Item="mart_workspace_monthly_billing"]}[Data]
			in
				Navigation
